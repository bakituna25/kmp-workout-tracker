-- Migration 2: Add sort_order column to scheduled_workouts table (manual drag-reorder)

ALTER TABLE scheduled_workouts ADD COLUMN sort_order INTEGER NOT NULL DEFAULT 0;

-- Backfill existing rows so the visible order (previously "newest id first")
-- stays identical until the user actually drags an item to reorder it.
UPDATE scheduled_workouts
SET sort_order = (
    SELECT COUNT(*) FROM scheduled_workouts sw2
    WHERE sw2.date_epoch_day = scheduled_workouts.date_epoch_day
      AND sw2.id > scheduled_workouts.id
);
