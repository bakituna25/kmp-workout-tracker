-- WorkoutDayPlan Table
CREATE TABLE IF NOT EXISTS workout_day_plans (
    date TEXT NOT NULL PRIMARY KEY,
    planned_exercise_count INTEGER NOT NULL,
    created_at INTEGER NOT NULL
);

-- Queries

-- Insert
insertWorkoutDayPlan:
INSERT OR REPLACE INTO workout_day_plans(date, planned_exercise_count, created_at)
VALUES (?, ?, ?);

-- Select
getWorkoutDayPlan:
SELECT * FROM workout_day_plans WHERE date = ?;

dayPlanExists:
SELECT COUNT(1) FROM workout_day_plans WHERE date = ?;

-- Delete
deleteWorkoutDayPlan:
DELETE FROM workout_day_plans WHERE date = ?;

