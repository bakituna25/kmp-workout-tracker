-- WorkoutPlanSet Table
CREATE TABLE IF NOT EXISTS workout_plan_sets (
    plan_item_id INTEGER NOT NULL,
    set_index INTEGER NOT NULL,
    planned_reps INTEGER,
    planned_weight REAL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY(plan_item_id, set_index),
    FOREIGN KEY(plan_item_id) REFERENCES workout_planner_items(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS index_workout_plan_sets_plan_item_id ON workout_plan_sets(plan_item_id);

-- Queries

-- Insert
insertWorkoutPlanSets:
INSERT OR REPLACE INTO workout_plan_sets(plan_item_id, set_index, planned_reps, planned_weight, created_at)
VALUES (?, ?, ?, ?, ?);

-- Select
getPlanSetsForItem:
SELECT * FROM workout_plan_sets WHERE plan_item_id = ? ORDER BY set_index;

getWorkoutPlanSetsForItem:
SELECT * FROM workout_plan_sets WHERE plan_item_id = ?;

getPlannedSetsCount:
SELECT COALESCE(SUM(wpi.sets), 0) FROM workout_planner_items wpi
INNER JOIN scheduled_workouts sw ON sw.plan_item_id = wpi.id
WHERE sw.date_epoch_day = CAST((julianday(?) - julianday('1970-01-01')) AS INTEGER);

-- Delete
deletePlanSetsForItem:
DELETE FROM workout_plan_sets WHERE plan_item_id = ?;

