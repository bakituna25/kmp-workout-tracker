-- UserProfile Table (Simplified for Profile Screen)
CREATE TABLE IF NOT EXISTS UserProfile (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    name TEXT NOT NULL DEFAULT 'Misafir',
    height REAL,
    weight REAL,
    fatRatio REAL,
    age INTEGER,
    gender TEXT,
    avatar BLOB
);

-- Queries

-- Get User Profile (always returns single user with id=1)
getUser:
SELECT * FROM UserProfile WHERE id = 1;

-- Insert or Update User Profile
-- NOTE: this is a full-row REPLACE, so avatar must always be passed through
-- (from the caller's current known value) or a profile-field edit would wipe it.
insertOrUpdate:
INSERT OR REPLACE INTO UserProfile(id, name, height, weight, fatRatio, age, gender, avatar)
VALUES (1, ?, ?, ?, ?, ?, ?, ?);

-- Creates the id=1 row if it doesn't exist yet (e.g. before the user has
-- ever tapped Kaydet); a no-op otherwise. Must run before updateAvatar,
-- since UPDATE ... WHERE id = 1 silently affects zero rows without it.
ensureProfileRow:
INSERT OR IGNORE INTO UserProfile(id) VALUES (1);

-- Update only the avatar photo, leaving every other field untouched
updateAvatar:
UPDATE UserProfile SET avatar = ? WHERE id = 1;
