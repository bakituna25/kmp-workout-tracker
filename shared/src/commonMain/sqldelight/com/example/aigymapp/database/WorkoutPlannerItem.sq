-- WorkoutPlannerItem Table
CREATE TABLE IF NOT EXISTS workout_planner_items (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    session_id INTEGER NOT NULL,
    exercise_id INTEGER NOT NULL,
    sets INTEGER NOT NULL DEFAULT 3,
    reps INTEGER NOT NULL DEFAULT 10,
    weight_kg REAL NOT NULL DEFAULT 0.0,
    duration_min INTEGER NOT NULL DEFAULT 0,
    rest_sec INTEGER,
    notes TEXT,
    created_at INTEGER NOT NULL,
    FOREIGN KEY(session_id) REFERENCES workout_planner_sessions(id) ON DELETE CASCADE,
    FOREIGN KEY(exercise_id) REFERENCES exercises(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS index_workout_planner_items_session_id ON workout_planner_items(session_id);
CREATE INDEX IF NOT EXISTS index_workout_planner_items_exercise_id ON workout_planner_items(exercise_id);

-- Queries

-- Insert
insertItem:
INSERT INTO workout_planner_items(session_id, exercise_id, sets, reps, weight_kg, duration_min, rest_sec, notes, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertItemSync:
INSERT INTO workout_planner_items(session_id, exercise_id, sets, reps, weight_kg, duration_min, rest_sec, notes, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertWorkoutPlanItem:
INSERT INTO workout_planner_items(session_id, exercise_id, sets, reps, weight_kg, duration_min, rest_sec, notes, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Select
getItemById:
SELECT * FROM workout_planner_items WHERE id = ?;

getItemByIdSync:
SELECT * FROM workout_planner_items WHERE id = ?;

getItemsBySessionId:
SELECT * FROM workout_planner_items WHERE session_id = ? ORDER BY created_at;

getItemCountForSession:
SELECT COUNT(*) FROM workout_planner_items WHERE session_id = ?;

-- Complex queries with joins
getItemsWithExerciseBySessionId:
SELECT 
    wpi.id AS wpi_id,
    wpi.session_id AS wpi_session_id,
    wpi.exercise_id AS wpi_exercise_id,
    wpi.sets AS wpi_sets,
    wpi.reps AS wpi_reps,
    wpi.weight_kg AS wpi_weight_kg,
    wpi.duration_min AS wpi_duration_min,
    wpi.rest_sec AS wpi_rest_sec,
    wpi.notes AS wpi_notes,
    wpi.created_at AS wpi_created_at,
    e.name AS exercise_name,
    e.muscle_group AS exercise_muscle_group
FROM workout_planner_items wpi
INNER JOIN exercises e ON wpi.exercise_id = e.id
WHERE wpi.session_id = ?
ORDER BY wpi.created_at;

getItemsForDay:
SELECT 
    wpi.id AS wpi_id,
    wpi.session_id AS wpi_session_id,
    wpi.exercise_id AS wpi_exercise_id,
    wpi.sets AS wpi_sets,
    wpi.reps AS wpi_reps,
    wpi.weight_kg AS wpi_weight_kg,
    wpi.duration_min AS wpi_duration_min,
    wpi.rest_sec AS wpi_rest_sec,
    wpi.notes AS wpi_notes,
    wpi.created_at AS wpi_created_at,
    e.name AS exercise_name,
    e.muscle_group AS exercise_muscle_group
FROM workout_planner_items wpi
INNER JOIN workout_planner_sessions wps ON wpi.session_id = wps.id
INNER JOIN exercises e ON wpi.exercise_id = e.id
WHERE wps.date_epoch_day = ?
ORDER BY wpi.created_at;

getItemsForDayList:
SELECT 
    wpi.id AS wpi_id,
    wpi.session_id AS wpi_session_id,
    wpi.exercise_id AS wpi_exercise_id,
    wpi.sets AS wpi_sets,
    wpi.reps AS wpi_reps,
    wpi.weight_kg AS wpi_weight_kg,
    wpi.duration_min AS wpi_duration_min,
    wpi.rest_sec AS wpi_rest_sec,
    wpi.notes AS wpi_notes,
    wpi.created_at AS wpi_created_at,
    e.name AS exercise_name,
    e.muscle_group AS exercise_muscle_group
FROM workout_planner_items wpi
INNER JOIN workout_planner_sessions wps ON wpi.session_id = wps.id
INNER JOIN exercises e ON wpi.exercise_id = e.id
WHERE wps.date_epoch_day = ?
ORDER BY wpi.created_at;

getAllWorkoutPlannerItems:
SELECT * FROM workout_planner_items;

getAllItems:
SELECT * FROM workout_planner_items;

-- Update
updateItem:
UPDATE workout_planner_items 
SET session_id = ?, exercise_id = ?, sets = ?, reps = ?, weight_kg = ?, duration_min = ?, rest_sec = ?, notes = ?
WHERE id = ?;

updateWorkoutPlanItem:
UPDATE workout_planner_items 
SET session_id = ?, exercise_id = ?, sets = ?, reps = ?, weight_kg = ?, duration_min = ?, rest_sec = ?, notes = ?
WHERE id = ?;

-- Delete
deleteItem:
DELETE FROM workout_planner_items WHERE id = ?;

deleteItemById:
DELETE FROM workout_planner_items WHERE id = ?;

deleteItemsBySessionId:
DELETE FROM workout_planner_items WHERE session_id = ?;

-- Orphan cleanup
deleteOrphanItemsBySession:
DELETE FROM workout_planner_items 
WHERE NOT EXISTS (SELECT 1 FROM workout_planner_sessions s WHERE s.id = workout_planner_items.session_id);

deleteOrphanItemsByExercise:
DELETE FROM workout_planner_items 
WHERE NOT EXISTS (SELECT 1 FROM exercises e WHERE e.id = workout_planner_items.exercise_id);

