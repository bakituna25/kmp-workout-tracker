-- WorkoutLog Table
CREATE TABLE IF NOT EXISTS workout_logs (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    date TEXT NOT NULL,
    exercise_id INTEGER NOT NULL,
    planned_sets INTEGER NOT NULL,
    completed_sets INTEGER NOT NULL,
    total_reps INTEGER,
    total_weight REAL,
    started_at INTEGER,
    finished_at INTEGER
);

CREATE INDEX IF NOT EXISTS index_workout_logs_date ON workout_logs(date);

-- Queries

-- Insert
insert:
INSERT INTO workout_logs(date, exercise_id, planned_sets, completed_sets, total_reps, total_weight, started_at, finished_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Select
selectAll:
SELECT * FROM workout_logs ORDER BY date DESC;

selectById:
SELECT * FROM workout_logs WHERE id = ?;

selectByDate:
SELECT * FROM workout_logs WHERE date = ? ORDER BY id;

-- Update
update:
UPDATE workout_logs 
SET date = ?, exercise_id = ?, planned_sets = ?, completed_sets = ?, total_reps = ?, total_weight = ?, started_at = ?, finished_at = ?
WHERE id = ?;

-- Delete
deleteById:
DELETE FROM workout_logs WHERE id = ?;

deleteByDate:
DELETE FROM workout_logs WHERE date = ?;

deleteAll:
DELETE FROM workout_logs;

