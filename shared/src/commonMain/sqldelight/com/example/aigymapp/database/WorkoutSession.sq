-- WorkoutSession Table
CREATE TABLE IF NOT EXISTS workout_sessions (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    template_id INTEGER,
    name TEXT NOT NULL,
    start_time INTEGER NOT NULL,
    end_time INTEGER,
    total_duration INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'IN_PROGRESS',
    notes TEXT,
    rating INTEGER NOT NULL DEFAULT 0,
    calories_burned INTEGER NOT NULL DEFAULT 0,
    total_weight_lifted REAL NOT NULL DEFAULT 0.0,
    total_sets INTEGER NOT NULL DEFAULT 0,
    total_reps INTEGER NOT NULL DEFAULT 0,
    created_date INTEGER NOT NULL,
    completed_sets INTEGER NOT NULL DEFAULT 0,
    total_exercises INTEGER NOT NULL DEFAULT 0,
    completed_exercises INTEGER NOT NULL DEFAULT 0,
    completion_percentage REAL NOT NULL DEFAULT 0.0,
    performance_grade TEXT NOT NULL DEFAULT 'D',
    personal_records_count INTEGER NOT NULL DEFAULT 0,
    achievements_earned INTEGER NOT NULL DEFAULT 0,
    average_rest_time INTEGER NOT NULL DEFAULT 0,
    workout_intensity REAL NOT NULL DEFAULT 0.0,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(template_id) REFERENCES workout_templates(id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS index_workout_sessions_template_id ON workout_sessions(template_id);

-- Queries

-- Insert
insertWorkoutSession:
INSERT INTO workout_sessions(template_id, name, start_time, end_time, total_duration, status, notes, rating, calories_burned, total_weight_lifted, total_sets, total_reps, created_date, completed_sets, total_exercises, completed_exercises, completion_percentage, performance_grade, personal_records_count, achievements_earned, average_rest_time, workout_intensity, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Select
getAllWorkoutSessions:
SELECT * FROM workout_sessions ORDER BY start_time DESC;

getRecentWorkoutSessions:
SELECT * FROM workout_sessions ORDER BY start_time DESC LIMIT 10;

getWorkoutSessionById:
SELECT * FROM workout_sessions WHERE id = ?;

searchWorkoutSessions:
SELECT * FROM workout_sessions WHERE name LIKE '%' || ? || '%' ORDER BY start_time DESC;

getTotalWorkoutCount:
SELECT COUNT(*) FROM workout_sessions;

getWorkoutCountSince:
SELECT COUNT(*) FROM workout_sessions WHERE start_time >= ?;

getAverageWorkoutDuration:
SELECT AVG(CASE WHEN total_duration > 0 THEN total_duration/60000.0 ELSE 45 END) FROM workout_sessions;

getThisWeekWorkoutCount:
SELECT COUNT(*) FROM workout_sessions WHERE start_time >= ?;

getThisMonthWorkoutCount:
SELECT COUNT(*) FROM workout_sessions WHERE start_time >= ?;

getTotalWorkoutDurationMs:
SELECT COALESCE(SUM(total_duration), 0) FROM workout_sessions WHERE status = 'COMPLETED';

-- Update
updateWorkoutSession:
UPDATE workout_sessions 
SET template_id = ?, name = ?, start_time = ?, end_time = ?, total_duration = ?, status = ?, notes = ?, rating = ?, calories_burned = ?, total_weight_lifted = ?, total_sets = ?, total_reps = ?, completed_sets = ?, total_exercises = ?, completed_exercises = ?, completion_percentage = ?, performance_grade = ?, personal_records_count = ?, achievements_earned = ?, average_rest_time = ?, workout_intensity = ?, updated_at = ?
WHERE id = ?;

-- Delete
deleteWorkoutSession:
DELETE FROM workout_sessions WHERE id = ?;

deleteAllWorkoutSessions:
DELETE FROM workout_sessions;

