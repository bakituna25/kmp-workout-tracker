-- WorkoutTemplate Table
CREATE TABLE IF NOT EXISTS workout_templates (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    muscle_groups TEXT NOT NULL,
    estimated_duration INTEGER NOT NULL DEFAULT 0,
    difficulty_level TEXT NOT NULL DEFAULT 'BEGINNER',
    created_date INTEGER NOT NULL,
    is_favorite INTEGER NOT NULL DEFAULT 0,
    exercise_count INTEGER NOT NULL DEFAULT 0,
    category TEXT NOT NULL DEFAULT 'STRENGTH'
);

-- Queries

-- Insert
insertWorkoutTemplate:
INSERT INTO workout_templates(name, description, muscle_groups, estimated_duration, difficulty_level, created_date, is_favorite, exercise_count, category)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Select
getAllWorkoutTemplates:
SELECT * FROM workout_templates ORDER BY name ASC;

getWorkoutTemplateById:
SELECT * FROM workout_templates WHERE id = ?;

searchWorkoutTemplates:
SELECT * FROM workout_templates WHERE name LIKE '%' || ? || '%';

-- Update
updateWorkoutTemplate:
UPDATE workout_templates 
SET name = ?, description = ?, muscle_groups = ?, estimated_duration = ?, difficulty_level = ?, is_favorite = ?, exercise_count = ?, category = ?
WHERE id = ?;

-- Delete
deleteWorkoutTemplate:
DELETE FROM workout_templates WHERE id = ?;

deleteAllWorkoutTemplates:
DELETE FROM workout_templates;

