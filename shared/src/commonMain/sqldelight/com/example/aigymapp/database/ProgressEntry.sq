-- ProgressEntry Table
CREATE TABLE IF NOT EXISTS progress_entries (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    date INTEGER NOT NULL,
    weight REAL NOT NULL DEFAULT 0.0,
    body_fat_percentage REAL NOT NULL DEFAULT 0.0,
    muscle_mass REAL NOT NULL DEFAULT 0.0,
    water_percentage REAL NOT NULL DEFAULT 0.0,
    notes TEXT,
    photo_path TEXT,
    mood_rating INTEGER NOT NULL DEFAULT 0,
    energy_level INTEGER NOT NULL DEFAULT 0,
    sleep_hours REAL NOT NULL DEFAULT 0.0,
    waist_circumference REAL NOT NULL DEFAULT 0.0,
    chest_circumference REAL NOT NULL DEFAULT 0.0,
    arm_circumference REAL NOT NULL DEFAULT 0.0,
    thigh_circumference REAL NOT NULL DEFAULT 0.0,
    created_time INTEGER NOT NULL
);

-- Queries

-- Insert
insertProgressEntry:
INSERT INTO progress_entries(date, weight, body_fat_percentage, muscle_mass, water_percentage, notes, photo_path, mood_rating, energy_level, sleep_hours, waist_circumference, chest_circumference, arm_circumference, thigh_circumference, created_time)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Select
getAllProgressEntries:
SELECT * FROM progress_entries ORDER BY date DESC;

getProgressEntryById:
SELECT * FROM progress_entries WHERE id = ?;

getRecentProgressEntries:
SELECT * FROM progress_entries ORDER BY date DESC LIMIT 10;

getLatestProgressEntry:
SELECT * FROM progress_entries ORDER BY date DESC LIMIT 1;

getAverageWeight:
SELECT AVG(weight) FROM progress_entries WHERE weight > 0;

getMinWeight:
SELECT MIN(weight) FROM progress_entries WHERE weight > 0;

getMaxWeight:
SELECT MAX(weight) FROM progress_entries WHERE weight > 0;

-- Update
updateProgressEntry:
UPDATE progress_entries 
SET date = ?, weight = ?, body_fat_percentage = ?, muscle_mass = ?, water_percentage = ?, notes = ?, photo_path = ?, mood_rating = ?, energy_level = ?, sleep_hours = ?, waist_circumference = ?, chest_circumference = ?, arm_circumference = ?, thigh_circumference = ?, created_time = ?
WHERE id = ?;

-- Delete
deleteProgressEntry:
DELETE FROM progress_entries WHERE id = ?;

deleteAllProgressEntries:
DELETE FROM progress_entries;

